{
  "name": "ASR Extension (Offscreen Example)",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [     
    "tabs",
    "storage",
    "activeTab",
    "tabCapture",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [ 
        "asr/*.wasm",            
        "asr/*.js",
        "asr/*.data"         
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "ASR Extension"
  }
}
