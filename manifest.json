{
  "name": "ASR Extension (Offscreen Example)",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [
    "tabCapture",    
    "offscreen",       
    "tabs"        
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "offscreen.html",     
        "asr/*.wasm",            
        "asr/*.js"            
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "ASR Extension"
  }
}
